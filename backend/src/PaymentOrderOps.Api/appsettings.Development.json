{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5544;Database=payment_order_ops;Username=ops;Password=ops_local_pw"
  },
  "MessageBrokers": {
    "Dev": {
      "RabbitMq": {
        "ManagementUrl": "http://localhost:15672",
        "Username": "ops",
        "Password": "ops_local_pw",
        "VirtualHost": "/",
        "DeadLetterQueuePatterns": [ "*.dlq", "*.dead-letter", "*.dlx" ]
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "SecurityProtocol": "Plaintext",
        "DeadLetterTopicPatterns": [ "*.DLT", "*.dlq", "*.dead-letter" ],
        "ConsumerGroupLagWarningThreshold": 1000,
        "ConsumerGroupLagCriticalThreshold": 25000
      }
    }
  },
  "CompanyApis": {
    "Dev": {
      "orders": { "BaseUrl": "", "AuthRef": "", "TimeoutSeconds": 30 },
      "invoices": { "BaseUrl": "", "AuthRef": "", "TimeoutSeconds": 30 },
      "shipments": { "BaseUrl": "", "AuthRef": "", "TimeoutSeconds": 30 },
      "merchant": { "BaseUrl": "", "AuthRef": "", "TimeoutSeconds": 30 }
    }
  },
  "SoapServices": {
    "Dev": {
      "invoices": { "Endpoint": "", "AuthRef": "", "DefaultSoapAction": "", "TimeoutSeconds": 30 }
    }
  },
  "CompanyDb": {
    "Dev": { "ConnectionString": "", "CommandTimeoutSeconds": 15 }
  },
  "Auth": {
    "Dev": {
      "companyAuth": { "Kind": "none" }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
