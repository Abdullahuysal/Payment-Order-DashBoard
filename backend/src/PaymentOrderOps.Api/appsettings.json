{
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "MessageBrokers": {
    "Dev": {
      "RabbitMq": {
        "ManagementUrl": "",
        "Username": "",
        "Password": "",
        "VirtualHost": "/",
        "DeadLetterQueuePatterns": [ "*.dlq", "*.dead-letter", "*.dlx" ]
      },
      "Kafka": {
        "BootstrapServers": "",
        "SecurityProtocol": "Plaintext",
        "SaslMechanism": null,
        "SaslUsername": null,
        "SaslPassword": null,
        "DeadLetterTopicPatterns": [ "*.DLT", "*.dlq", "*.dead-letter" ],
        "ConsumerGroupLagWarningThreshold": 1000,
        "ConsumerGroupLagCriticalThreshold": 25000
      }
    },
    "Preprod": {
      "RabbitMq": { "ManagementUrl": "", "Username": "", "Password": "", "VirtualHost": "/" },
      "Kafka": { "BootstrapServers": "" }
    },
    "Production": {
      "RabbitMq": { "ManagementUrl": "", "Username": "", "Password": "", "VirtualHost": "/" },
      "Kafka": { "BootstrapServers": "" }
    }
  },
  "CompanyApis": {
    "Dev": {},
    "Preprod": {},
    "Production": {}
  },
  "SoapServices": {
    "Dev": {},
    "Preprod": {},
    "Production": {}
  },
  "CompanyDb": {
    "Dev": { "ConnectionString": "", "CommandTimeoutSeconds": 15 },
    "Preprod": { "ConnectionString": "", "CommandTimeoutSeconds": 15 },
    "Production": { "ConnectionString": "", "CommandTimeoutSeconds": 15 }
  },
  "Auth": {
    "Dev": {},
    "Preprod": {},
    "Production": {}
  },
  "TestRuns": {
    "AllowedEnvironments": [ "dev", "preprod" ],
    "MaxBulkCount": 10,
    "MaxBulkConcurrency": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
