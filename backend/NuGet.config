<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Isolate the build from machine-wide feeds (e.g. private GitLab sources that
       require credentials); this repo only needs nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
