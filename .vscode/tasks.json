{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: db up",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "backend: db down",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "backend: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/PaymentOrderOps.slnx",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "backend: run prep",
      "dependsOrder": "sequence",
      "dependsOn": ["backend: db up", "backend: build"],
      "problemMatcher": []
    },
    {
      "label": "backend: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/backend/PaymentOrderOps.slnx"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
