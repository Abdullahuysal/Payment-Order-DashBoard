{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "backend: PaymentOrderOps.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: run prep",
      "program": "${workspaceFolder}/backend/src/PaymentOrderOps.Api/bin/Debug/net10.0/PaymentOrderOps.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/PaymentOrderOps.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      }
    }
  ]
}
